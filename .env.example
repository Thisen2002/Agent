# Copy this file to .env and fill in your own values:  cp .env.example .env

# Required: password for the web interface (Jarvis will not start without it)
JARVIS_PASSWORD=change-me

# Optional: home city for the weather tool when no city is given
JARVIS_CITY=Colombo

# Optional: where facts, chats and documents are stored (default: ./memory)
# JARVIS_DATA_DIR=/path/to/jarvis-data
